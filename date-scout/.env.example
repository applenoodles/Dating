# File: .env.example

# ---------- LLM（選用，不填會用規則版摘要）----------
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=

# ---------- 搜尋後端（可串多家、每家可串多把免費金鑰）----------
# fallback 順序，前一家沒額度/失敗就換下一家
SEARCH_PROVIDER_ORDER=brave,google,searxng,ddgs

# Brave Search（免費 tier，每把約 2000 次/月）。多把金鑰用逗號分隔，自動輪替。
# 申請：https://brave.com/search/api/
BRAVE_API_KEYS=

# Google Programmable Search / Custom Search JSON（免費每把 100 次/天）。
# 申請金鑰：https://developers.google.com/custom-search/v1/overview
# 建立搜尋引擎拿 cx：https://programmablesearchengine.google.com/
GOOGLE_CSE_KEYS=
GOOGLE_CSE_CX=

# SearXNG 公開實例（免金鑰）。多個用逗號分隔，會輪替 + 失敗冷卻。
# 公開實例清單：https://searx.space/
SEARXNG_INSTANCES=

# ddgs（DuckDuckGo，免金鑰，最後備援，較不穩，不需設定）

# ---------- Threads 即時搜尋（選用、需金鑰，留空則整個 Threads 來源自動略過）----------
# 非官方 Threads 搜尋 API。我們只當 API 客戶端，不自行登入、不繞驗證。
# 預設接 ScrapeCreators：申請免費金鑰 https://scrapecreators.com/
# 額度與 ToS 由該服務決定（每把金鑰有上限、Threads 每次約只回 10 筆）。
THREADS_API_KEY=
THREADS_API_PROVIDER=scrapecreators

# ---------- LLM 金鑰池閘道（選用，見 docker-compose.llm-gateway.yml）----------
# 若用 LiteLLM 閘道串多把 LLM 金鑰，這幾個給 docker-compose 用，
# 然後把上面的 LLM_BASE_URL 設成 http://localhost:4000/v1、LLM_API_KEY 設成 LITELLM_MASTER_KEY
LITELLM_MASTER_KEY=sk-local-master
OPENAI_KEY_1=
OPENAI_KEY_2=
GROQ_KEY=
